# assetto_corsa_gym config.yml overrides for SINGLE-PC training (AC and the learner on this machine).
# One key=value per line (OmegaConf dotlist); train_ac.ps1 passes them after --config config.yml.
AssettoCorsa.remote_machine_ip=127.0.0.1   # not "localhost": Windows resolves the name on every UDP sendto
AssettoCorsa.vjoy_executed_by_server=True   # must match the installed plugin (install_ac_plugin.ps1: 100 Hz, plugin drives vJoy)
AssettoCorsa.track=ks_barcelona-layout_gp   # ships with AC, and with an assetto_corsa_gym racing line
AssettoCorsa.car=dallara_f317               # upstream's car maps; the SF70H has none for this trainer
disable_wandb=True
