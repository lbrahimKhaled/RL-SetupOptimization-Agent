          py::arg("torque_Nm") = std::array<double, 3>{0., 0., 0.})
     .def("signal_names", &Car::signal_names)
-    .def("signals", &Car::signals, py::arg("names"));
+    .def("signals", &Car::signals, py::arg("names"))
